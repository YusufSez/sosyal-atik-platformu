# Ortam değişkenleri — bu dosyayı .env olarak kopyalayın
# Üretimde güçlü bir anahtar üretin: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=degistirin-gizli-anahtar-en-az-32-karakter-olmalidir
# Google Gemini — ilan görsel analizi ve mesaj içerik denetimi
GEMINI_API_KEY=your_gemini_api_key_here
# Yerel: development | Üretim (VPS/Docker): production veya boş (DEBUG=False → production)
APP_ENV=development
DEBUG=False
ALLOW_SEED_ROUTE=False

# Rate limiting
# Yerel: RATELIMIT_STORAGE_URI=memory:// veya RATELIMIT_BACKEND=memory
# Üretim (çoklu worker): RATELIMIT_BACKEND=redis + REDIS_URL=redis://redis:6379/0
# Alternatif: RATELIMIT_STORAGE_URI=redis://localhost:6379/0
RATELIMIT_BACKEND=memory
RATELIMIT_STORAGE_URI=memory://
# REDIS_URL=redis://redis:6379/0
# RATELIMIT_STRICT=False   # True: Redis yoksa uygulama başlamaz (üretim önerilir)

# Socket.IO CORS — production'da zorunlu; DEBUG=True iken localhost varsayılanları kullanılır
# SOCKETIO_CORS_ORIGINS=https://atikport.com,https://www.atikport.com

# HTTPS (nginx/Caddy arkasında)
BEHIND_PROXY=False
FORCE_HTTPS=False
# ZAP/üretim HTTPS taraması için HSTS (FORCE_HTTPS olmadan da etkinleştirilebilir)
ENABLE_HSTS=False

# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
# Hostname listesine tarayıcıda açtığınız TAM alan adını ekleyin (ör. atikport.example.com, localhost)
# IP adresi (10.x.x.x, 192.168.x.x) ÇALIŞMAZ — Kubernetes iç IP ile erişiyorsanız ingress/domain veya port-forward+localhost kullanın
# Yerel test anahtarları (her hostname'de çalışır):
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ENABLED=False

# Veritabanı — PostgreSQL (üretim / Docker) veya SQLite (yerel geliştirme)
# Tam bağlantı dizesi (öncelikli):
# DATABASE_URL=postgresql+psycopg2://postgres:SIFRE@localhost:5432/atikport

# --- Yerel geliştirme (SQLite) ---
USE_POSTGRES=False
# SQLITE_PATH=site.db

# --- PostgreSQL (yerel veya Docker) ---
# USE_POSTGRES=True
# POSTGRES_HOST=localhost          # Docker web servisi içinde: postgres
# POSTGRES_PORT=5432
# POSTGRES_DB=atikport
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=guclu-sifre
# POSTGRES_WAIT_SECONDS=90         # Docker entrypoint bekleme süresi (sn)

# Alembic / Flask-Migrate
FLASK_APP=app.py
# Üretim ve PostgreSQL: False (şema `flask db upgrade` ile). Yerel DEBUG+SQLite: True (create_all)
AUTO_CREATE_DB=False

# Gemini AI
GEMINI_REQUEST_TIMEOUT_MS=30000
# API kesintisinde fotoğraflı ilan yüklemeyi geçici izin ver (varsayılan: False = fail-closed)
AI_UPLOAD_FAIL_OPEN=False

# Demo Modu — TEKNOFEST sunumu için örnek veri (Admin paneli ayarı bunu override eder)
DEMO_MODE=False

# Veritabanı yedekleme (SQLite için; PostgreSQL'de pg_dump kullanın)
BACKUP_ENABLED=True
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=7
BACKUP_INTERVAL_HOURS=24

# Hata ve uygulama günlükleri (logs/app.log, logs/errors.log)
LOG_DIR=logs

# Süper admin — yalnızca bu e-posta admin yetkisi verebilir/alabilir
# İlk kayıtta bu e-posta otomatik admin olur
ADMIN_EMAIL=admin@example.com

# E-posta (Brevo SMTP) — https://app.brevo.com/settings/keys/smtp
SITE_NAME=AtıkPort
MAIL_SERVER=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-brevo-login-email@example.com
MAIL_PASSWORD=your-brevo-smtp-key
MAIL_DEFAULT_SENDER=AtıkPort <noreply@yourdomain.com>
# İsteğe bağlı Brevo REST API anahtarı — Kubernetes/Docker gibi değişken IP ortamlarında
# SMTP IP kısıtı (525 Unauthorized IP) sorununu önler; doluysa API öncelikli kullanılır
BREVO_API_KEY=
# Kamuya açık site adresi — e-posta doğrulama / şifre sıfırlama bağlantıları (zorunlu önerilir)
# Docker (nginx 8080): http://localhost:8080
# Yerel geliştirme:       http://127.0.0.1:5000
# Üretim:                 https://alanadim.com
SITE_URL=http://127.0.0.1:5000
EMAIL_TOKEN_MAX_AGE=86400
EMAIL_VERIFICATION_REQUIRED=True
MAIL_SUPPRESS_SEND=False
