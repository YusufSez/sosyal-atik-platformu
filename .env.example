# Ortam değişkenleri — bu dosyayı .env olarak kopyalayın
# Üretimde güçlü bir anahtar üretin: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=degistirin-gizli-anahtar-en-az-32-karakter-olmalidir
GEMINI_API_KEY=your_gemini_api_key_here
DEBUG=False
ALLOW_SEED_ROUTE=False

# Rate limiting (çoklu worker için Redis önerilir)
RATELIMIT_STORAGE_URI=memory://

# HTTPS (nginx/Caddy arkasında)
BEHIND_PROXY=False
FORCE_HTTPS=False

# Google reCAPTCHA v2 (https://www.google.com/recaptcha/admin)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_ENABLED=False

# İlk admin kullanıcısı oluşturmak için (opsiyonel, migration sonrası DB'den de ayarlanabilir)
# ADMIN_EMAIL=admin@example.com
