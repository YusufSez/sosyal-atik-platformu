# atikport.com VPS production .env şablonu
# Kullanım: cp deploy/env.production.example .env  (proje kökünde)
# Ardından tüm <...> değerlerini doldurun. Bu dosyayı asla commit etmeyin.

SECRET_KEY=<python -c "import secrets; print(secrets.token_hex(32))">
GEMINI_API_KEY=<gemini-api-key>
APP_ENV=production
DEBUG=False
ALLOW_SEED_ROUTE=False

USE_POSTGRES=True
POSTGRES_DB=atikport
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<guclu-sifre>

SITE_URL=https://atikport.com
SITE_NAME=AtıkPort

BEHIND_PROXY=True
FORCE_HTTPS=True
ENABLE_HSTS=True

ADMIN_EMAIL=<admin@email.com>

MAIL_SERVER=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=<brevo-login>
MAIL_PASSWORD=<brevo-smtp-key>
MAIL_DEFAULT_SENDER=AtıkPort <noreply@atikport.com>
BREVO_API_KEY=<brevo-rest-api-key>
EMAIL_VERIFICATION_REQUIRED=True
MAIL_SUPPRESS_SEND=False

TURNSTILE_ENABLED=True
TURNSTILE_SITE_KEY=<turnstile-site-key>
TURNSTILE_SECRET_KEY=<turnstile-secret-key>

RATELIMIT_BACKEND=memory
RATELIMIT_STORAGE_URI=memory://
# Üretim (çoklu worker): docker compose --profile redis ile redis servisini açın
# RATELIMIT_BACKEND=redis
# REDIS_URL=redis://redis:6379/0
# RATELIMIT_STRICT=True

SOCKETIO_CORS_ORIGINS=https://atikport.com,https://www.atikport.com
SOCKETIO_ASYNC_MODE=eventlet
BACKUP_ENABLED=False
FLASK_APP=app.py

# Compose interpolasyonu (deploy/.env — opsiyonel, kök .env ile aynı tutun)
# POSTGRES_PASSWORD aynı
# SITE_URL=https://atikport.com
